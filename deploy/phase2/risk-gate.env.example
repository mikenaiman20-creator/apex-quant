# Copy to risk-gate.env with mode 600; never commit actual tokens.
# Generate each value independently with: openssl rand -hex 32
RISK_GATE_TOKEN=replace-with-a-random-64-character-hex-token
RISK_ADMIN_TOKEN=replace-with-a-different-random-64-character-hex-token
RISK_GATE_URL=http://127.0.0.1:18765
