# GitHub OAuth application callback URL must exactly match this value.
# Local/staging over HTTPS: https://<DASHBOARD_DOMAIN>/oauth2/callback
# Never mix schemes: an http:// redirect against an https:// dashboard fails
# the OAuth state check or triggers a browser "dangerous site" warning.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://151.145.93.209.nip.io/oauth2/callback
OAUTH2_PROXY_COOKIE_DOMAIN=151.145.93.209.nip.io
OAUTH2_PROXY_WHITELIST_DOMAINS=.151.145.93.209.nip.io
OAUTH2_PROXY_COOKIE_SECURE=true
